# HTTP headers του site στο Cloudflare (το GitHub Pages δεν επέτρεπε δικά μας headers).
# Το .eleventy.js το αντιγράφει στο _site/, από όπου το διαβάζει το Cloudflare.

/*
  # Μόνο HTTPS για έναν χρόνο, ακόμα κι αν κάποιος γράψει http://
  Strict-Transport-Security: max-age=31536000
  # Ο browser δεν «μαντεύει» τύπο αρχείου (π.χ. δεν τρέχει ένα .txt σαν script)
  X-Content-Type-Options: nosniff
  # Το site δεν μπαίνει μέσα σε iframe άλλου site (clickjacking)
  X-Frame-Options: DENY
  # Στα εξωτερικά sites φαίνεται μόνο ότι ήρθαν από το desekordonia.com, όχι ποια σελίδα
  Referrer-Policy: strict-origin-when-cross-origin
  # Κάμερα, μικρόφωνο, πληρωμές: κανείς δεν τα χρειάζεται εδώ. Τοποθεσία: μόνο το ίδιο
  # το site (κουμπί «Χρησιμοποίησε τη θέση μου» στο Ρυθμός & Καιρός), ποτέ ξένα iframes
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  # same-origin-allow-popups (όχι same-origin): το παράθυρο «Συνέχεια με την Google» της σελίδας
  # login χρειάζεται να μιλά με τη σελίδα που το άνοιξε
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # CSP: από πού επιτρέπεται να φορτώνει η σελίδα. Ό,τι δεν είναι στη λίστα μπλοκάρεται,
  # οπότε ακόμα κι αν κάποιος καταφέρει να βάλει δικό του script, δεν μπορεί να στείλει
  # δεδομένα πουθενά. Εξωτερικά: GoatCounter (στατιστικά), OpenStreetMap (χάρτης αγώνων),
  # Supabase (likes), το API (λογαριασμός, newsletter), το Open-Meteo (καιρός, αναζήτηση πόλης)
  # και η Google (κουμπί «Σύνδεση με Google» στη σελίδα login, μόνο από το accounts.google.com/gsi/).
  # 'wasm-unsafe-eval': για την αναζήτηση (Pagefind).
  # 'unsafe-inline' στα scripts και στα styles: ΜΟΝΟ εδώ, επειδή ένα header δεν μπορεί να έχει
  # διαφορετικά hashes ανά σελίδα. Κάθε σελίδα έχει και δικό της <meta http-equiv="Content-Security-Policy">
  # με το hash κάθε inline script και κάθε <style> (το φτιάχνει το .eleventy.js, «cspHashes»· τα
  # style="…" γίνονται εκεί κανόνες σε <style>). Ο browser εφαρμόζει ΚΑΙ τις δύο πολιτικές, οπότε
  # ισχύουν μόνο τα δικά μας scripts και styles. Δες docs/adr/0002 και 0008.
  # Νέα εξωτερική υπηρεσία με script ή CSS: μπαίνει εδώ ΚΑΙ στο SCRIPT_SOURCES / STYLE_SOURCES του .eleventy.js.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://gc.zgo.at https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https://tile.openstreetmap.org https://nikol.goatcounter.com; font-src 'self'; connect-src 'self' https://api.desekordonia.com https://kblnwbcyhkgnuwrgzmdt.supabase.co https://nikol.goatcounter.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://accounts.google.com/gsi/; worker-src 'self' blob:; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# CSS/JS: κάθε αλλαγή αλλάζει το ?v=<hash> στο URL, οπότε ο browser μπορεί να τα κρατά
# για έναν χρόνο χωρίς να ξαναρωτά.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts και Leaflet: σταθερά αρχεία με την έκδοση στο όνομα/φάκελο
/fonts/*
  Cache-Control: public, max-age=2592000
/vendor/*
  Cache-Control: public, max-age=2592000

# Αρχεία ημερολογίου των αγώνων («Πρόσθεσε στο ημερολόγιο»): ως ημερολόγιο, όχι ως κείμενο,
# ώστε το κινητό να προτείνει να το ανοίξει με την εφαρμογή ημερολογίου. Μία μέρα cache,
# γιατί η ημερομηνία ή η ώρα μπορεί να αλλάξει.
/ics/*
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=86400

# Εικόνες: μία εβδομάδα
/images/*
  Cache-Control: public, max-age=604800
