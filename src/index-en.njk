  <div class="modal-overlay" id="whyModal" role="dialog" aria-modal="true" aria-label="Why do you run?">
    <div class="modal">
      <div id="whyBody">
        <h3>Why do you run?</h3>
        <div class="why-options">
          <button type="button">Mental calm</button>
          <button type="button">A clear mind</button>
          <button type="button">To lose weight</button>
          <button type="button">To improve my endurance</button>
        </div>
        <button class="modal-close" id="whyClose">Close</button>
      </div>
    </div>
  </div>
{% endblock %}

