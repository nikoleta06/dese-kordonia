---
permalink: "login-en.html"
noindex: true
lang: "en"
title: "Newsletter: subscribe or sign in | Δέσε Κορδόνια"
description: "Sign in to Δέσε Κορδόνια with your email (no password needed) and subscribe to the newsletter."
---

{% extends "base.njk" %}

{% block head_extra0 %}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex">
  <link rel="canonical" href="https://desekordonia.com/login-en.html">
  <link rel="alternate" hreflang="el" href="https://desekordonia.com/login.html">
  <link rel="alternate" hreflang="en" href="https://desekordonia.com/login-en.html">
  <link rel="alternate" hreflang="x-default" href="https://desekordonia.com/login.html">
{% endblock %}

{% block head_extra2 %}{% endblock %}

{% block content %}
  <main class="login-main">
    <h1 class="section-title">Join the newsletter</h1>
    <p class="lead">
      Enter your email and we'll send you a link to subscribe to the
      newsletter, no password needed.
    </p>

    <div class="calc login-card">
      <div class="login-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <div class="input-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>
          <input type="email" id="email" autocomplete="username email" placeholder="you@example.com">
        </div>
        {#- "Continue with Google": opens as soon as someone taps the email field (js/google-signin.js) #}
        <div class="google-pop" id="googlePop" hidden>
          <div class="google-pop-head">
            <span>Faster, no email needed</span>
            <button class="google-pop-close" type="button" aria-label="Close">×</button>
          </div>
          <div class="google-pop-btn" id="googleBtn"></div>
          <p class="google-pop-error" id="googleError" role="alert" hidden></p>
          <p class="google-pop-hint">or type your email above</p>
        </div>
      </div>

      {#- .pop-anchor: where each button's message bubble attaches #}
      <div class="pop-anchor">
        <button class="btn btn-block" id="sendBtn" type="button">Send me a link</button>
      </div>
      {#- Shown to everyone after sending (not only new users: otherwise the page
          would reveal whether an email is already registered) #}
      <p class="spam-note" id="spamNote" hidden>
        <b>First time here?</b> If you don't see our email within a few minutes, check your
        <b>Spam / Junk</b> folder too. Δέσε Κορδόνια is a new site and your email provider
        doesn't "know" it yet, so the first time it may land there.
      </p>

      {#- For existing members: Face ID (if the device supports it) or a password.
          First-time visitors always start from the email above #}
      <div class="login-divider">Already subscribed?</div>
      <div class="pop-anchor" id="passkeyArea" hidden>
        <button class="btn-passkey" id="passkeyBtn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
          Use Face ID / fingerprint
        </button>
      </div>
      {#- No Face ID in this browser (usually a page opened inside Instagram, Facebook, Viber, etc.):
          one line "Face ID is not available here…" instead of just hiding the button; tapping it
          shows why, along with the copy-link button -#}
      <details class="passkey-note" id="passkeyNote" hidden>
        <summary>Face ID is not available here…</summary>
        <p id="passkeyNoteText"></p>
        <button class="passkey-note-btn" id="copyLinkBtn" type="button">Copy link</button>
        <p class="passkey-note-done" id="copyLinkDone" role="status" aria-live="polite"></p>
      </details>

      <button class="btn-ghost btn-ghost-block" id="pwToggle" type="button" aria-expanded="false" aria-controls="pwPanel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Sign in with a password
      </button>
      {#- Uses the email from the field above #}
      <div class="pw-panel" id="pwPanel" hidden>
        <div class="field">
          <label for="password">Password</label>
          <div class="input-wrap pw-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" id="password" autocomplete="current-password" placeholder="Your password">
            <button class="pw-eye" id="pwEye" type="button" aria-pressed="false" aria-label="Show password" title="Show password"></button>
          </div>
        </div>
        <div class="pop-anchor">
          <button class="btn btn-block" id="pwLoginBtn" type="button">Sign in</button>
        </div>
        <p class="passkey-hint">No password yet, or forgot it? Tap "Send me a link", sign in, and set it from your account.</p>
      </div>

      <p class="passkey-hint" id="memberHint">No Face ID or password set? Sign in with your email above.</p>

      <p class="login-trust">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your email is used only for sign-in and the newsletter. We never share it. <a href="privacy-en.html">Privacy policy</a>
      </p>

    </div>

    <ul class="login-perks">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Get the newsletter with new articles and running tips</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg> Set up your profile with your name and a few words about you</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.27"/></svg> Unsubscribe from the newsletter anytime, with one click</li>
    </ul>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="js/vendor/simplewebauthn-browser-14.0.0.umd.min.js"></script>
  <script src="js/passkey.js?v={{ "js/passkey.js" | assetHash }}"></script>
  <script src="js/password.js?v={{ "js/password.js" | assetHash }}"></script>
  <script src="js/google-signin.js?v={{ "js/google-signin.js" | assetHash }}"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const API = (location.hostname === 'localhost') ? 'http://localhost:4000' : 'https://api.desekordonia.com';

      // Message in a bubble above the button that was tapped (not at the end of
      // the form, which on phones is often below the fold)
      let popTimer;
      function showPop(btn, text, isError) {
        document.querySelectorAll('.dk-pop').forEach((p) => p.remove());
        clearTimeout(popTimer);
        const pop = document.createElement('div');
        pop.className = 'dk-pop' + (isError ? ' dk-pop-error' : '');
        pop.setAttribute('role', isError ? 'alert' : 'status');
        const msg = document.createElement('span');
        msg.textContent = text;
        const close = document.createElement('button');
        close.type = 'button';
        close.className = 'dk-pop-close';
        close.setAttribute('aria-label', 'Close');
        close.textContent = '×';
        close.addEventListener('click', () => pop.remove());
        pop.append(msg, close);
        btn.closest('.pop-anchor').appendChild(pop);
        popTimer = setTimeout(() => pop.remove(), 9000);
      }

      async function requestLink() {
        const email = $('email').value.trim();
        if (!email || !email.includes('@')) {
          showPop($('sendBtn'), 'Enter a valid email.', true);
          return;
        }
        const btn = $('sendBtn');
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
          const r = await fetch(API + '/api/auth/request-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, language: 'en' })
          });
          if (r.ok) {
            showPop(btn, "We've sent you a link — open your email and tap it (valid for 15 minutes).", false);
            $('spamNote').hidden = false;
            btn.textContent = '✓ Link sent';
            setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 5000);
            return;
          }
          showPop(btn, 'Something went wrong. Please try again.', true);
        } catch (e) {
          showPop(btn, "Couldn't reach the server. Try again in a moment.", true);
        }
        btn.textContent = label;
        btn.disabled = false;
      }

      // Passkey: only if the browser supports it; options are fetched ahead of time (see js/passkey.js)
      async function passkeyLogin() {
        const btn = $('passkeyBtn');
        btn.disabled = true;
        try {
          await DKPasskey.login();
          location.href = 'account-en.html';
          return;
        } catch (e) {
          if (DKPasskey.isCancel(e)) {
            showPop(btn, "You haven't turned on Face ID for this device yet. Enter your email above — after you sign in we'll offer to turn it on.", true);
          } else if (e.status === 400) {
            showPop(btn, "This device's Face ID is no longer linked to an account. Enter your email above and turn it on again after you sign in.", true);
          } else {
            showPop(btn, 'Something went wrong. Try again or enter your email above.', true);
          }
          DKPasskey.prepareLogin();
        }
        btn.disabled = false;
      }

      // Inside an app (Instagram, Facebook, Viber…) Face ID does not work, even if the browser says it
      // is supported. There, and in browsers without passkeys, we explain what the visitor can do
      if (DKPasskey.supported() && !DKPasskey.inAppBrowser()) {
        $('passkeyArea').hidden = false;
        DKPasskey.prepareLogin();
        $('passkeyBtn').addEventListener('click', passkeyLogin);
      } else {
        $('passkeyNoteText').textContent = DKPasskey.inAppBrowser()
          ? 'Face ID does not work inside apps such as Instagram, Facebook or Viber. Open the page in Safari or Chrome (the app menu ⋯ or ⋮ → "Open in browser") or copy the link. Until then, sign in with a password or your email.'
          : 'This browser does not support Face ID. Open the page in Safari or Chrome, or sign in with a password or your email.';
        $('passkeyNote').hidden = false;
        $('copyLinkBtn').addEventListener('click', async () => {
          const url = location.origin + location.pathname;
          try {
            await navigator.clipboard.writeText(url);
            $('copyLinkDone').textContent = 'Copied. Paste it into Safari or Chrome.';
          } catch (e) {
            $('copyLinkDone').textContent = 'Could not copy. Type this into Safari or Chrome: ' + url.replace(/^https?:\/\//, '');
          }
        });
      }

      /* --- Password: for members who set one (also older phones without Face ID) --- */
      $('pwToggle').addEventListener('click', () => {
        $('pwToggle').hidden = true;
        $('pwToggle').setAttribute('aria-expanded', 'true');
        $('pwPanel').hidden = false;
        $('memberHint').hidden = true;
        ($('email').value.trim() ? $('password') : $('email')).focus();
      });
      DKPassword.wireToggle($('password'), $('pwEye'), { show: 'Show password', hide: 'Hide password' });

      async function passwordLogin() {
        const btn = $('pwLoginBtn');
        const email = $('email').value.trim();
        const password = $('password').value;
        if (!email || !email.includes('@')) {
          showPop(btn, 'Enter your email in the field above.', true);
          return;
        }
        if (!password) {
          showPop(btn, 'Enter your password.', true);
          return;
        }
        btn.disabled = true;
        try {
          await DKPassword.login(email, password);
          location.href = 'account-en.html';
          return;
        } catch (e) {
          if (e.status === 401) {
            showPop(btn, "Wrong email or password. If you haven't set a password, tap \"Send me a link\" above.", true);
          } else if (e.status === 429) {
            showPop(btn, 'Too many attempts. Try again in 15 minutes or tap "Send me a link".', true);
          } else {
            showPop(btn, "Couldn't reach the server. Try again in a moment.", true);
          }
        }
        btn.disabled = false;
      }
      $('pwLoginBtn').addEventListener('click', passwordLogin);
      $('password').addEventListener('keydown', (e) => { if (e.key === 'Enter') passwordLogin(); });

      DKGoogle.attach({
        input: $('email'),
        panel: $('googlePop'),
        button: $('googleBtn'),
        error: $('googleError'),
        language: 'en',
        messages: {
          taken: 'This email is already signed up here. Type it above and tap "Send me a link".',
          failed: "Google sign-in didn't work. Type your email above and tap \"Send me a link\"."
        }
      });
      $('sendBtn').addEventListener('click', requestLink);
      $('email').addEventListener('keydown', (e) => { if (e.key === 'Enter') requestLink(); });
    })();
  </script>
{% endblock %}
