---
permalink: "login-en.html"
lang: "en"
title: "Sign in or sign up | Δέσε Κορδόνια"
description: "Sign in to Δέσε Κορδόνια with your email — no password needed — and subscribe to the newsletter."
---

{% extends "base.njk" %}

{% block head_extra0 %}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex">
  <link rel="canonical" href="https://desekordonia.com/login-en.html">
  <link rel="alternate" hreflang="el" href="https://desekordonia.com/login.html">
  <link rel="alternate" hreflang="en" href="https://desekordonia.com/login-en.html">
  <link rel="alternate" hreflang="x-default" href="https://desekordonia.com/login.html">
{% endblock %}

{% block head_extra2 %}{% endblock %}

{% block content %}
  <main>
    <h1 class="section-title">Sign in or sign up</h1>
    <p class="lead">
      Enter your email and we'll send you a link. If it's your first time,
      that's also how you sign up — no password needed.
    </p>

    <div class="calc login-card">
      <div class="login-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <div class="input-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>
          <input type="email" id="email" placeholder="you@example.com">
        </div>
      </div>

      <button class="btn btn-block" id="sendBtn" type="button">Send me a link</button>

      {#- Second option, only for people who already turned on a passkey —
          first-time visitors always start from the email above #}
      <div id="passkeyArea" hidden>
        <div class="login-divider">or</div>
        <button class="btn-passkey" id="passkeyBtn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
          Sign in with Face ID / fingerprint
        </button>
        <p class="passkey-hint">If you've already turned it on for this device</p>
      </div>

      <p class="login-trust">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your email is used only for sign-in and the newsletter — we never share it. <a href="privacy-en.html">Privacy policy</a>
      </p>

      <div class="calc-result calc-hidden" id="result"></div>
    </div>

    <ul class="login-perks">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Get the newsletter with new articles and running tips</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg> Set up your profile with your name and a few words about you</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.27"/></svg> Unsubscribe from the newsletter anytime, with one click</li>
    </ul>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="js/vendor/simplewebauthn-browser-14.0.0.umd.min.js"></script>
  <script src="js/passkey.js?v={{ site.jsVersion }}"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const API = (location.hostname === 'localhost') ? 'http://localhost:4000' : 'https://api.desekordonia.com';

      function showResult(text, isError) {
        const el = $('result');
        el.textContent = text;
        el.classList.remove('calc-hidden');
        el.style.color = isError ? 'var(--accent-2)' : '';
      }

      async function requestLink() {
        const email = $('email').value.trim();
        if (!email || !email.includes('@')) {
          showResult('Enter a valid email.', true);
          return;
        }
        const btn = $('sendBtn');
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        try {
          const r = await fetch(API + '/api/auth/request-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, language: 'en' })
          });
          if (r.ok) {
            showResult('Check your email for the sign-in link (valid for 15 minutes).', false);
            btn.textContent = '✓ Link sent';
            setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 5000);
            return;
          }
          showResult('Something went wrong. Please try again.', true);
        } catch (e) {
          showResult("Couldn't reach the server. Is it running locally?", true);
        }
        btn.textContent = label;
        btn.disabled = false;
      }

      // Passkey: only if the browser supports it; options are fetched ahead of time (see js/passkey.js)
      async function passkeyLogin() {
        const btn = $('passkeyBtn');
        btn.disabled = true;
        try {
          await DKPasskey.login();
          location.href = 'account-en.html';
          return;
        } catch (e) {
          if (DKPasskey.isCancel(e)) {
            showResult("You haven't turned on Face ID for this device yet. Enter your email above — after you sign in we'll offer to turn it on.", true);
          } else if (e.status === 400) {
            showResult("This device's Face ID is no longer linked to an account. Enter your email above and turn it on again after you sign in.", true);
          } else {
            showResult('Something went wrong. Try again or enter your email above.', true);
          }
          DKPasskey.prepareLogin();
        }
        btn.disabled = false;
      }

      if (DKPasskey.supported()) {
        $('passkeyArea').hidden = false;
        DKPasskey.prepareLogin();
        $('passkeyBtn').addEventListener('click', passkeyLogin);
      }

      $('sendBtn').addEventListener('click', requestLink);
      $('email').addEventListener('keydown', (e) => { if (e.key === 'Enter') requestLink(); });
    })();
  </script>
{% endblock %}
