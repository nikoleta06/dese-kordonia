---
permalink: "verify-en.html"
lang: "en"
title: "Verifying sign-in | Δέσε Κορδόνια"
description: "Verifying your sign-in link."
---

{% extends "base.njk" %}

{% block head_extra0 %}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex">
  <link rel="canonical" href="https://desekordonia.com/verify-en.html">
  <link rel="alternate" hreflang="el" href="https://desekordonia.com/verify.html">
  <link rel="alternate" hreflang="en" href="https://desekordonia.com/verify-en.html">
  <link rel="alternate" hreflang="x-default" href="https://desekordonia.com/verify.html">
{% endblock %}

{% block head_extra2 %}{% endblock %}

{% block content %}
  <main>
    <h1 class="section-title">Verifying sign-in</h1>
    <div class="calc">
      <p id="status">Checking your link...</p>
      <a class="btn calc-hidden" id="loginLink" href="login-en.html">Back to sign in</a>

      {#- After the email sign-in: offer a faster way for next time.
          Face ID only if the device supports it; a password works everywhere (older phones too) #}
      <div class="passkey-offer" id="passkeyOffer" hidden>
        <p>Next time, sign in faster without waiting for an email? Choose how:</p>
        <button class="btn-passkey" id="passkeyYes" type="button" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
          With Face ID / fingerprint
        </button>
        <button class="btn-ghost btn-ghost-block" id="pwChoose" type="button" aria-expanded="false" aria-controls="pwSetPanel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          With a password
        </button>
        <div class="pw-panel" id="pwSetPanel" hidden>
          <div class="field">
            <label for="newPassword">New password</label>
            <div class="input-wrap pw-wrap">
              <input type="password" id="newPassword" autocomplete="new-password" minlength="8" placeholder="8+ characters">
              <button class="pw-eye" id="pwEye" type="button" aria-pressed="false" aria-label="Show password" title="Show password"></button>
            </div>
          </div>
          <button class="btn btn-block" id="pwSave" type="button">Save password</button>
        </div>
        <p class="login-trust"><a href="account-en.html">Not now, take me to my account</a></p>
      </div>
    </div>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="js/vendor/simplewebauthn-browser-14.0.0.umd.min.js"></script>
  <script src="js/passkey.js?v={{ site.jsVersion }}"></script>
  <script src="js/password.js?v={{ site.jsVersion }}"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const API = (location.hostname === 'localhost') ? 'http://localhost:4000' : 'https://api.desekordonia.com';

      async function verify() {
        const token = new URLSearchParams(location.search).get('token');
        if (!token) {
          $('status').textContent = 'Missing verification token.';
          $('loginLink').classList.remove('calc-hidden');
          return;
        }
        try {
          const r = await fetch(API + '/api/auth/verify?token=' + encodeURIComponent(token), {
            credentials: 'include'
          });
          if (r.ok) {
            // Offer Face ID or a password so next time no email is needed
            $('status').textContent = 'You\'re signed in!';
            if (DKPasskey.supported()) {
              await DKPasskey.prepareRegister();
              $('passkeyYes').hidden = false;
            }
            $('passkeyOffer').hidden = false;
          } else {
            $('status').textContent = 'This link has expired or is invalid.';
            $('loginLink').classList.remove('calc-hidden');
          }
        } catch (e) {
          $('status').textContent = "Couldn't reach the server. Is it running locally?";
          $('loginLink').classList.remove('calc-hidden');
        }
      }

      $('passkeyYes').addEventListener('click', async () => {
        const btn = $('passkeyYes');
        btn.disabled = true;
        try {
          await DKPasskey.register();
          $('passkeyOffer').hidden = true;
          $('status').textContent = 'Done! Next time tap "Use Face ID / fingerprint" on the sign-in page. Redirecting to your account...';
          setTimeout(() => { location.href = 'account-en.html'; }, 2000);
          return;
        } catch (e) {
          if (DKPasskey.isAlreadyRegistered(e)) {
            $('status').textContent = 'Face ID is already on for this device.';
          } else if (DKPasskey.isCancel(e)) {
            $('status').textContent = 'Cancelled. You can turn it on any time from your account.';
          } else {
            $('status').textContent = 'Couldn\'t turn it on. Try again from your account.';
          }
          DKPasskey.prepareRegister();
        }
        btn.disabled = false;
      });

      $('pwChoose').addEventListener('click', () => {
        $('pwChoose').hidden = true;
        $('pwChoose').setAttribute('aria-expanded', 'true');
        $('pwSetPanel').hidden = false;
        $('newPassword').focus();
      });
      DKPassword.wireToggle($('newPassword'), $('pwEye'), { show: 'Show password', hide: 'Hide password' });

      async function savePassword() {
        const btn = $('pwSave');
        const password = $('newPassword').value;
        if (password.length < DKPassword.MIN_LENGTH) {
          $('status').textContent = 'Your password needs at least 8 characters.';
          $('newPassword').focus();
          return;
        }
        btn.disabled = true;
        try {
          await DKPassword.set(password);
          $('passkeyOffer').hidden = true;
          $('status').textContent = 'Done! Next time tap "Sign in with a password" on the sign-in page. Redirecting to your account...';
          setTimeout(() => { location.href = 'account-en.html'; }, 2000);
          return;
        } catch (e) {
          if (e.status === 400) $('status').textContent = 'Your password needs at least 8 characters.';
          else if (e.status === 401) $('status').textContent = 'Your session has expired. Request a new link and set the password from your account.';
          else $('status').textContent = 'Couldn\'t save the password. Try again or set it from your account.';
        }
        btn.disabled = false;
      }
      $('pwSave').addEventListener('click', savePassword);
      $('newPassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') savePassword(); });

      verify();
    })();
  </script>
{% endblock %}
