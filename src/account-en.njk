---
permalink: "account-en.html"
noindex: true
lang: "en"
title: "My account | Δέσε Κορδόνια"
description: "Your profile on Δέσε Κορδόνια."
---

{% extends "base.njk" %}

{% block head_extra0 %}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex">
  <link rel="canonical" href="https://desekordonia.com/account-en.html">
  <link rel="alternate" hreflang="el" href="https://desekordonia.com/account.html">
  <link rel="alternate" hreflang="en" href="https://desekordonia.com/account-en.html">
  <link rel="alternate" hreflang="x-default" href="https://desekordonia.com/account.html">
{% endblock %}

{% block head_extra2 %}{% endblock %}

{% block content %}
  <main>
    <h1 class="section-title">My account</h1>
    <p class="lead calc-hidden" id="intro">Your profile.</p>

    <div class="calc calc-hidden" id="form">
      <div class="field">
        <label>Email</label>
        <input type="text" id="email" disabled>
      </div>
      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" placeholder="Your name">
      </div>
      <div class="field">
        <label for="bio">A few words about you</label>
        <input type="text" id="bio" placeholder="e.g. Running since 2023">
      </div>
      <div class="newsletter-box">
        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Newsletter</h4>
        <p>New articles and running tips, straight to your inbox.</p>
        <label><input type="checkbox" id="newsletter"> I want to receive the newsletter</label>
        <p class="lang-question">In which language?</p>
        <div class="lang-options">
          <label><input type="radio" name="lang" id="langEl" value="el"> Ελληνικά</label>
          <label><input type="radio" name="lang" id="langEn" value="en"> English</label>
        </div>
      </div>

      <div class="newsletter-box" id="passkeyBox" hidden>
        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg> Sign in with Face ID / fingerprint</h4>
        <p>On the devices you've turned this on for, you're in with one tap, no email.</p>
        <ul class="passkey-list" id="passkeyList"></ul>
        <button class="btn-passkey" id="passkeyAdd" type="button">Turn on for this device</button>
        <p id="passkeyMsg" hidden></p>
      </div>

      {#- Password: optional, works on any device (older phones without Face ID too) #}
      <div class="newsletter-box" id="passwordBox">
        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Sign in with a password</h4>
        <p id="pwState"></p>
        {#- Current password: only asked when a password exists and the user signed in with it #}
        <div class="field" id="pwCurrentField" hidden>
          <label for="currentPassword">Current password</label>
          <div class="input-wrap pw-wrap">
            <input type="password" id="currentPassword" autocomplete="current-password" placeholder="Your password">
            <button class="pw-eye" id="pwEyeCurrent" type="button" aria-pressed="false" aria-label="Show password" title="Show password"></button>
          </div>
        </div>
        <div class="field">
          <label for="newPassword">New password</label>
          <div class="input-wrap pw-wrap">
            <input type="password" id="newPassword" autocomplete="new-password" minlength="8" placeholder="8+ characters">
            <button class="pw-eye" id="pwEye" type="button" aria-pressed="false" aria-label="Show password" title="Show password"></button>
          </div>
        </div>
        <button class="btn-passkey" id="pwSave" type="button"></button>
        <p id="pwMsg" hidden></p>
        <div class="pw-remove-row">
          <button class="btn-danger-link" id="pwRemove" type="button" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg> Remove password</button>
        </div>
      </div>

      {#- Google: shown only to people who signed in with "Continue with Google" #}
      <div class="newsletter-box" id="googleBox" hidden>
        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Sign-in with Google</h4>
        <p id="googleState">Your account is linked to Google: you sign in with "Continue with Google" on the sign-in page, no waiting for a link.</p>
        <p id="googleMsg" hidden></p>
        <div class="pw-remove-row">
          <button class="btn-danger-link" id="googleUnlink" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18.84 12.25 1.72-1.71a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="m5.17 11.75-1.71 1.71a5 5 0 0 0 7.07 7.07l1.71-1.71"/><line x1="8" y1="2" x2="8" y2="5"/><line x1="2" y1="8" x2="5" y2="8"/><line x1="16" y1="19" x2="16" y2="22"/><line x1="19" y1="16" x2="22" y2="16"/></svg> Unlink Google</button>
        </div>
      </div>

      {#- Main action + sign out (same height; stacked on phones) #}
      <div class="account-actions">
        <button class="btn" id="saveBtn" type="button">Save</button>
        <button class="btn-ghost" id="logoutBtn" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg> Sign out</button>
      </div>

      <div class="calc-result calc-hidden" id="result"></div>

      {#- Delete kept apart and low-key so it is not tapped by mistake #}
      <div class="account-danger">
        <button class="btn-danger-link" id="deleteBtn" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg> Delete account</button>
      </div>
    </div>

    <p id="status">Checking your session...</p>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="js/vendor/simplewebauthn-browser-14.0.0.umd.min.js"></script>
  <script src="js/passkey.js?v={{ "js/passkey.js" | assetHash }}"></script>
  <script src="js/password.js?v={{ "js/password.js" | assetHash }}"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const API = (location.hostname === 'localhost') ? 'http://localhost:4000' : 'https://api.desekordonia.com';

      function fill(user) {
        $('email').value = user.email;
        $('name').value = user.name || '';
        $('bio').value = user.bio || '';
        $('newsletter').checked = !!user.newsletter_subscribed;
        $(user.language === 'en' ? 'langEn' : 'langEl').checked = true;
        $('status').classList.add('calc-hidden');
        $('intro').classList.remove('calc-hidden');
        $('form').classList.remove('calc-hidden');
      }

      async function load() {
        try {
          const r = await fetch(API + '/api/auth/me', { credentials: 'include' });
          if (!r.ok) {
            location.href = 'login-en.html';
            return;
          }
          const user = await r.json();
          fill(user);
          initPasskeys();
          renderPassword(!!user.has_password, user.signed_in_with);
          $('googleBox').hidden = !user.has_google;
        } catch (e) {
          $('status').textContent = "Couldn't reach the server. Is it running locally?";
        }
      }

      async function save() {
        $('saveBtn').disabled = true;
        try {
          const r = await fetch(API + '/api/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              name: $('name').value.trim(),
              bio: $('bio').value.trim(),
              newsletter_subscribed: $('newsletter').checked,
              language: $('langEn').checked ? 'en' : 'el'
            })
          });
          const result = $('result');
          result.classList.remove('calc-hidden');
          result.textContent = r.ok ? 'Saved!' : 'Something went wrong.';
        } catch (e) {
          const result = $('result');
          result.classList.remove('calc-hidden');
          result.textContent = "Couldn't reach the server.";
        }
        $('saveBtn').disabled = false;
      }

      async function logout() {
        try {
          await fetch(API + '/api/auth/logout', { method: 'POST', credentials: 'include' });
        } catch (e) {}
        location.href = 'index-en.html';
      }

      async function deleteAccount() {
        if (!confirm('Are you sure you want to delete your account? All your data will be erased and this cannot be undone.')) return;
        $('deleteBtn').disabled = true;
        try {
          await fetch(API + '/api/profile', { method: 'DELETE', credentials: 'include' });
        } catch (e) {}
        location.href = 'index-en.html';
      }

      /* --- Passkeys (Face ID / fingerprint) --- */
      function passkeyMsg(text) {
        $('passkeyMsg').textContent = text;
        $('passkeyMsg').hidden = !text;
      }

      function fmtDate(iso) {
        return iso ? new Date(iso).toLocaleDateString('en-GB') : '';
      }

      async function renderPasskeys() {
        const list = $('passkeyList');
        let keys = [];
        try { keys = await DKPasskey.list(); } catch (e) {}
        list.innerHTML = '';
        keys.forEach((k) => {
          const li = document.createElement('li');
          const info = document.createElement('div');
          info.textContent = k.device_label || 'Device';
          const meta = document.createElement('small');
          meta.textContent = 'Added ' + fmtDate(k.created_at) +
            (k.last_used_at ? ' · last sign-in ' + fmtDate(k.last_used_at) : '');
          info.appendChild(meta);
          const del = document.createElement('button');
          del.type = 'button';
          del.textContent = 'Remove';
          del.addEventListener('click', async () => {
            if (!confirm('Remove Face ID sign-in for this device? You can always sign in with email.')) return;
            try { await DKPasskey.remove(k.id); } catch (e) {}
            renderPasskeys();
          });
          li.appendChild(info);
          li.appendChild(del);
          list.appendChild(li);
        });
      }

      function initPasskeys() {
        if (!DKPasskey.supported()) return;
        $('passkeyBox').hidden = false;
        renderPasskeys();
        DKPasskey.prepareRegister();
      }

      $('passkeyAdd').addEventListener('click', async () => {
        const btn = $('passkeyAdd');
        btn.disabled = true;
        passkeyMsg('');
        try {
          await DKPasskey.register();
          passkeyMsg('Done! Next time tap "Sign in with Face ID / fingerprint" on the sign-in page.');
          renderPasskeys();
        } catch (e) {
          if (DKPasskey.isAlreadyRegistered(e)) passkeyMsg('Face ID is already on for this device.');
          else if (DKPasskey.isCancel(e)) passkeyMsg('Cancelled.');
          else passkeyMsg("Couldn't turn it on. Try again.");
        }
        DKPasskey.prepareRegister();
        btn.disabled = false;
      });

      /* --- Password --- */
      let hasPassword = false;
      let needCurrent = false; // υπάρχει κωδικός και ο χρήστης μπήκε με κωδικό

      function pwMsg(text) {
        $('pwMsg').textContent = text;
        $('pwMsg').hidden = !text;
      }

      function renderPassword(has, signedInWith) {
        hasPassword = has;
        needCurrent = has && signedInWith === 'password';
        $('pwState').textContent = has ? 'You\'ve set a password: sign in with your email and password, no waiting for a link.' : 'No password set. Set one to sign in with email and password, no waiting for a link. Works on any phone.';
        $('pwSave').textContent = has ? 'Change password' : 'Set password';
        $('pwRemove').hidden = !has;
        $('pwCurrentField').hidden = !needCurrent;
        $('currentPassword').value = '';
      }

      DKPassword.wireToggle($('newPassword'), $('pwEye'), { show: 'Show password', hide: 'Hide password' });
      DKPassword.wireToggle($('currentPassword'), $('pwEyeCurrent'), { show: 'Show password', hide: 'Hide password' });

      // Κοινός χειρισμός λαθών για αλλαγή / αφαίρεση
      function pwError(e) {
        if (DKPassword.isWrongCurrent(e)) {
          pwMsg('Your current password is wrong.');
          $('currentPassword').focus();
        } else if (e.status === 400) {
          pwMsg('Your password needs at least 8 characters.');
        } else if (e.status === 401) {
          pwMsg('Your session has expired or the password was changed on another device. Please sign in again.');
        } else {
          pwMsg('Couldn\'t save the password. Try again.');
        }
      }

      function currentOrAsk() {
        const current = $('currentPassword').value;
        if (needCurrent && !current) {
          pwMsg('Enter your current password first.');
          $('currentPassword').focus();
          return null;
        }
        return current;
      }

      async function savePassword() {
        const btn = $('pwSave');
        const password = $('newPassword').value;
        pwMsg('');
        const current = currentOrAsk();
        if (current === null) return;
        if (password.length < DKPassword.MIN_LENGTH) {
          pwMsg('Your password needs at least 8 characters.');
          $('newPassword').focus();
          return;
        }
        btn.disabled = true;
        try {
          const r = await DKPassword.set(password, current);
          const changed = hasPassword;
          $('newPassword').value = '';
          // Μετά την αλλαγή ο χρήστης έχει πάλι session «με κωδικό» μόνο αν είχε ήδη
          renderPassword(true, needCurrent ? 'password' : null);
          pwMsg(changed && r.otherDevicesSignedOut ? 'Password changed. Any other devices that were signed in have been signed out — you stay signed in here.' : 'Done! Next time tap "Sign in with a password" on the sign-in page.');
        } catch (e) {
          pwError(e);
        }
        btn.disabled = false;
      }
      $('pwSave').addEventListener('click', savePassword);
      $('newPassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') savePassword(); });
      $('currentPassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('newPassword').focus(); });

      $('pwRemove').addEventListener('click', async () => {
        pwMsg('');
        const current = currentOrAsk();
        if (current === null) return;
        if (!confirm('Remove your password? You\'ll sign in with an email link (or Face ID, if you\'ve turned it on), and any other signed-in devices will be signed out.')) return;
        try {
          await DKPassword.remove(current);
          renderPassword(false, null);
          pwMsg('Password removed and other devices signed out.');
        } catch (e) {
          pwError(e);
        }
      });

      /* --- Google --- */
      $('googleUnlink').addEventListener('click', async () => {
        if (!confirm("Unlink your account from Google? You'll sign in with an email link (or a password / Face ID, if you have them). You stay signed in here.")) return;
        const btn = $('googleUnlink');
        btn.disabled = true;
        let text;
        try {
          const r = await fetch(API + '/api/auth/google', { method: 'DELETE', credentials: 'include' });
          if (r.ok || r.status === 404) {
            $('googleState').hidden = true;
            btn.hidden = true;
            text = 'Your account is no longer linked to Google. From now on you sign in with an email link (or a password / Face ID, if you have them).';
          } else {
            text = r.status === 401 ? 'Your session has expired. Sign in again and try once more.' : "Couldn't unlink Google. Please try again.";
          }
        } catch (e) {
          text = "Couldn't unlink Google. Please try again.";
        }
        $('googleMsg').textContent = text;
        $('googleMsg').hidden = false;
        btn.disabled = false;
      });

      $('saveBtn').addEventListener('click', save);
      $('logoutBtn').addEventListener('click', logout);
      $('deleteBtn').addEventListener('click', deleteAccount);
      load();
    })();
  </script>
{% endblock %}
