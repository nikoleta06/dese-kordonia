---
permalink: "login.html"
noindex: true
lang: "el"
title: "Newsletter: εγγραφή ή σύνδεση | Δέσε Κορδόνια"
description: "Συνδέσου στο Δέσε Κορδόνια με το email σου (χωρίς κωδικό) και εγγράψου στο newsletter."
---

{% extends "base.njk" %}

{% block head_extra0 %}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex">

  <link rel="canonical" href="https://desekordonia.com/login.html">
  <link rel="alternate" hreflang="el" href="https://desekordonia.com/login.html">
  <link rel="alternate" hreflang="en" href="https://desekordonia.com/login-en.html">
  <link rel="alternate" hreflang="x-default" href="https://desekordonia.com/login.html">
{% endblock %}

{% block head_extra2 %}{% endblock %}

{% block content %}
  <main class="login-main">
    <h1 class="section-title">Γράψου στο newsletter</h1>
    <p class="lead">
      Γράψε το email σου και θα σου στείλουμε σύνδεσμο για να γραφτείς
      στο newsletter, χωρίς κωδικό.
    </p>

    <div class="calc login-card">
      <div class="login-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <div class="input-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>
          <input type="email" id="email" autocomplete="username email" placeholder="you@example.com">
        </div>
        {#- «Συνέχεια με την Google»: ανοίγει μόλις πατήσει κανείς στο πεδίο του email (js/google-signin.js) #}
        <div class="google-pop" id="googlePop" hidden>
          <div class="google-pop-head">
            <span>Πιο γρήγορα, χωρίς email</span>
            <button class="google-pop-close" type="button" aria-label="Κλείσιμο">×</button>
          </div>
          <div class="google-pop-btn" id="googleBtn"></div>
          <p class="google-pop-error" id="googleError" role="alert" hidden></p>
          <p class="google-pop-hint">ή γράψε το email σου από πάνω</p>
        </div>
      </div>

      {#- .pop-anchor: εκεί «κολλάει» το παραθυράκι με το μήνυμα του κάθε κουμπιού #}
      <div class="pop-anchor">
        <button class="btn btn-block" id="sendBtn" type="button">Στείλε μου σύνδεσμο</button>
      </div>
      {#- Φαίνεται σε όλους μετά την αποστολή (όχι μόνο στους νέους: αλλιώς η σελίδα
          θα αποκάλυπτε αν ένα email είναι ήδη γραμμένο στο site) #}
      <p class="spam-note" id="spamNote" hidden>
        <b>Πρώτη φορά εδώ;</b> Αν δεν δεις το email μας σε λίγα λεπτά, κοίτα και στα
        <b>Ανεπιθύμητα (Spam)</b>. Το Δέσε Κορδόνια είναι καινούργιο site και ο πάροχος
        του email σου δεν το «γνωρίζει» ακόμα, γι' αυτό την πρώτη φορά μπορεί να το βάλει εκεί.
      </p>

      {#- Για όσους είναι ήδη μέλη: Face ID (αν το υποστηρίζει η συσκευή) ή κωδικός.
          Ο νέος επισκέπτης ξεκινά πάντα από το email παραπάνω #}
      <div class="login-divider">Είσαι ήδη μέλος;</div>
      <div class="pop-anchor" id="passkeyArea" hidden>
        <button class="btn-passkey" id="passkeyBtn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
          Μπες με Face ID / δαχτυλικό
        </button>
      </div>
      {#- Χωρίς Face ID σε αυτόν τον browser (συνήθως σελίδα που άνοιξε μέσα από Instagram, Facebook,
          Viber κ.λπ.): μία γραμμή «Δεν υποστηρίζεται Face ID εδώ…» αντί να εξαφανίζεται απλώς το
          κουμπί· όποιος θέλει την πατά και βλέπει γιατί, μαζί με την αντιγραφή του συνδέσμου -#}
      <details class="passkey-note" id="passkeyNote" hidden>
        <summary>Δεν υποστηρίζεται Face ID εδώ…</summary>
        <p id="passkeyNoteText"></p>
        <button class="passkey-note-btn" id="copyLinkBtn" type="button">Αντιγραφή συνδέσμου</button>
        <p class="passkey-note-done" id="copyLinkDone" role="status" aria-live="polite"></p>
      </details>

      <button class="btn-ghost btn-ghost-block" id="pwToggle" type="button" aria-expanded="false" aria-controls="pwPanel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Μπες με κωδικό
      </button>
      {#- Χρησιμοποιεί το email από το πεδίο παραπάνω #}
      <div class="pw-panel" id="pwPanel" hidden>
        <div class="field">
          <label for="password">Κωδικός</label>
          <div class="input-wrap pw-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" id="password" autocomplete="current-password" placeholder="Ο κωδικός σου">
            <button class="pw-eye" id="pwEye" type="button" aria-pressed="false" aria-label="Εμφάνιση κωδικού" title="Εμφάνιση κωδικού"></button>
          </div>
        </div>
        <div class="pop-anchor">
          <button class="btn btn-block" id="pwLoginBtn" type="button">Σύνδεση</button>
        </div>
        <p class="passkey-hint">Δεν έχεις ακόμα κωδικό ή τον ξέχασες; Πάτα «Στείλε μου σύνδεσμο», μπες, και όρισέ τον από τον λογαριασμό σου.</p>
      </div>

      <p class="passkey-hint" id="memberHint">Δεν έχεις ορίσει Face ID ή κωδικό; Συνδέσου με το email σου παραπάνω.</p>

      <p class="login-trust">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Το email σου χρησιμοποιείται μόνο για σύνδεση και το newsletter. Δεν το μοιραζόμαστε ποτέ. <a href="privacy.html">Πολιτική απορρήτου</a>
      </p>
    </div>

    <ul class="login-perks">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Λαμβάνεις το newsletter με νέα άρθρα και συμβουλές για το τρέξιμο</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg> Φτιάχνεις το προφίλ σου με το όνομά σου και λίγα λόγια για σένα</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.27"/></svg> Μπορείς να διαγραφείς από το newsletter όποτε θέλεις, με ένα κλικ</li>
    </ul>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="js/vendor/simplewebauthn-browser-14.0.0.umd.min.js"></script>
  <script src="js/passkey.js?v={{ "js/passkey.js" | assetHash }}"></script>
  <script src="js/password.js?v={{ "js/password.js" | assetHash }}"></script>
  <script src="js/google-signin.js?v={{ "js/google-signin.js" | assetHash }}"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const API = (location.hostname === 'localhost') ? 'http://localhost:4000' : 'https://api.desekordonia.com';

      // Μήνυμα σε παραθυράκι πάνω από το κουμπί που πατήθηκε (όχι στο τέλος της
      // φόρμας, όπου στο κινητό συχνά δεν φαίνεται χωρίς σκρολ)
      let popTimer;
      function showPop(btn, text, isError) {
        document.querySelectorAll('.dk-pop').forEach((p) => p.remove());
        clearTimeout(popTimer);
        const pop = document.createElement('div');
        pop.className = 'dk-pop' + (isError ? ' dk-pop-error' : '');
        pop.setAttribute('role', isError ? 'alert' : 'status');
        const msg = document.createElement('span');
        msg.textContent = text;
        const close = document.createElement('button');
        close.type = 'button';
        close.className = 'dk-pop-close';
        close.setAttribute('aria-label', 'Κλείσιμο');
        close.textContent = '×';
        close.addEventListener('click', () => pop.remove());
        pop.append(msg, close);
        btn.closest('.pop-anchor').appendChild(pop);
        popTimer = setTimeout(() => pop.remove(), 9000);
      }

      async function requestLink() {
        const email = $('email').value.trim();
        if (!email || !email.includes('@')) {
          showPop($('sendBtn'), 'Βάλε ένα έγκυρο email.', true);
          return;
        }
        const btn = $('sendBtn');
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Αποστολή…';
        try {
          const r = await fetch(API + '/api/auth/request-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, language: 'el' })
          });
          if (r.ok) {
            showPop(btn, 'Σου στείλαμε σύνδεσμο — άνοιξε το email σου και πάτα τον (ισχύει 15 λεπτά).', false);
            $('spamNote').hidden = false;
            btn.textContent = '✓ Ο σύνδεσμος στάλθηκε';
            setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 5000);
            return;
          }
          showPop(btn, 'Κάτι πήγε στραβά. Δοκίμασε ξανά.', true);
        } catch (e) {
          showPop(btn, 'Δεν υπάρχει σύνδεση με τον server. Δοκίμασε ξανά σε λίγο.', true);
        }
        btn.textContent = label;
        btn.disabled = false;
      }

      // Passkey: μόνο αν το υποστηρίζει ο browser· οι επιλογές φορτώνονται από πριν (βλ. js/passkey.js)
      async function passkeyLogin() {
        const btn = $('passkeyBtn');
        btn.disabled = true;
        try {
          await DKPasskey.login();
          location.href = 'account.html';
          return;
        } catch (e) {
          if (DKPasskey.isCancel(e)) {
            showPop(btn, 'Δεν έχεις ενεργοποιήσει ακόμα Face ID σε αυτή τη συσκευή. Γράψε το email σου παραπάνω — μετά τη σύνδεση θα σου προτείνουμε να το ενεργοποιήσεις.', true);
          } else if (e.status === 400) {
            showPop(btn, 'Το Face ID αυτής της συσκευής δεν είναι πια συνδεδεμένο με λογαριασμό. Γράψε το email σου παραπάνω και ενεργοποίησέ το ξανά μετά τη σύνδεση.', true);
          } else {
            showPop(btn, 'Κάτι πήγε στραβά. Δοκίμασε ξανά ή γράψε το email σου παραπάνω.', true);
          }
          DKPasskey.prepareLogin();
        }
        btn.disabled = false;
      }

      // Μέσα σε εφαρμογή (Instagram, Facebook, Viber…) το Face ID δεν δουλεύει, κι ας λέει ο browser
      // ότι το υποστηρίζει. Εκεί, και σε browsers χωρίς passkeys, εξηγούμε τι να κάνει ο επισκέπτης
      if (DKPasskey.supported() && !DKPasskey.inAppBrowser()) {
        $('passkeyArea').hidden = false;
        DKPasskey.prepareLogin();
        $('passkeyBtn').addEventListener('click', passkeyLogin);
      } else {
        $('passkeyNoteText').textContent = DKPasskey.inAppBrowser()
          ? 'Το Face ID δεν δουλεύει μέσα σε εφαρμογές όπως το Instagram, το Facebook ή το Viber. Άνοιξε τη σελίδα στο Safari ή στο Chrome (μενού ⋯ ή ⋮ της εφαρμογής → «Άνοιγμα στο πρόγραμμα περιήγησης») ή αντίγραψε τον σύνδεσμο. Μέχρι τότε, μπες με κωδικό ή με το email σου.'
          : 'Αυτός ο browser δεν υποστηρίζει Face ID. Άνοιξε τη σελίδα στο Safari ή στο Chrome, ή μπες με κωδικό ή με το email σου.';
        $('passkeyNote').hidden = false;
        $('copyLinkBtn').addEventListener('click', async () => {
          const url = location.origin + location.pathname;
          try {
            await navigator.clipboard.writeText(url);
            $('copyLinkDone').textContent = 'Αντιγράφηκε. Επικόλλησέ τον στο Safari ή στο Chrome.';
          } catch (e) {
            $('copyLinkDone').textContent = 'Δεν έγινε αντιγραφή. Γράψε στο Safari ή στο Chrome: ' + url.replace(/^https?:\/\//, '');
          }
        });
      }

      /* --- Κωδικός: για όσους έχουν ορίσει (και σε παλιά κινητά χωρίς Face ID) --- */
      $('pwToggle').addEventListener('click', () => {
        $('pwToggle').hidden = true;
        $('pwToggle').setAttribute('aria-expanded', 'true');
        $('pwPanel').hidden = false;
        $('memberHint').hidden = true;
        ($('email').value.trim() ? $('password') : $('email')).focus();
      });
      DKPassword.wireToggle($('password'), $('pwEye'), { show: 'Εμφάνιση κωδικού', hide: 'Απόκρυψη κωδικού' });

      async function passwordLogin() {
        const btn = $('pwLoginBtn');
        const email = $('email').value.trim();
        const password = $('password').value;
        if (!email || !email.includes('@')) {
          showPop(btn, 'Γράψε το email σου στο πεδίο παραπάνω.', true);
          return;
        }
        if (!password) {
          showPop(btn, 'Γράψε τον κωδικό σου.', true);
          return;
        }
        btn.disabled = true;
        try {
          await DKPassword.login(email, password);
          location.href = 'account.html';
          return;
        } catch (e) {
          if (e.status === 401) {
            showPop(btn, 'Λάθος email ή κωδικός. Αν δεν έχεις ορίσει κωδικό, πάτα «Στείλε μου σύνδεσμο» παραπάνω.', true);
          } else if (e.status === 429) {
            showPop(btn, 'Πολλές προσπάθειες. Δοκίμασε ξανά σε 15 λεπτά ή πάτα «Στείλε μου σύνδεσμο».', true);
          } else {
            showPop(btn, 'Δεν υπάρχει σύνδεση με τον server. Δοκίμασε ξανά σε λίγο.', true);
          }
        }
        btn.disabled = false;
      }
      $('pwLoginBtn').addEventListener('click', passwordLogin);
      $('password').addEventListener('keydown', (e) => { if (e.key === 'Enter') passwordLogin(); });

      DKGoogle.attach({
        input: $('email'),
        panel: $('googlePop'),
        button: $('googleBtn'),
        error: $('googleError'),
        language: 'el',
        messages: {
          taken: 'Αυτό το email είναι ήδη γραμμένο εδώ. Γράψε το από πάνω και πάτα «Στείλε μου σύνδεσμο».',
          failed: 'Η σύνδεση με Google δεν έγινε. Γράψε το email σου από πάνω και πάτα «Στείλε μου σύνδεσμο».'
        }
      });
      $('sendBtn').addEventListener('click', requestLink);
      $('email').addEventListener('keydown', (e) => { if (e.key === 'Enter') requestLink(); });
    })();
  </script>
{% endblock %}
