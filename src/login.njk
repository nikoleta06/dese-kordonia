---
permalink: "login.html"
lang: "el"
title: "Σύνδεση ή εγγραφή | Δέσε Κορδόνια"
description: "Συνδέσου στο Δέσε Κορδόνια με το email σου — χωρίς κωδικό — και εγγράψου στο newsletter."
---

{% extends "base.njk" %}

{% block head_extra0 %}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex">

  <link rel="canonical" href="https://desekordonia.com/login.html">
  <link rel="alternate" hreflang="el" href="https://desekordonia.com/login.html">
  <link rel="alternate" hreflang="en" href="https://desekordonia.com/login-en.html">
  <link rel="alternate" hreflang="x-default" href="https://desekordonia.com/login.html">
{% endblock %}

{% block head_extra2 %}{% endblock %}

{% block content %}
  <main>
    <h1 class="section-title">Σύνδεση ή εγγραφή</h1>
    <p class="lead">
      Γράψε το email σου και θα σου στείλουμε έναν σύνδεσμο. Αν είναι η πρώτη
      σου φορά, έτσι γίνεται και η εγγραφή — δεν χρειάζεται κωδικός.
    </p>

    <div class="calc login-card">
      <div class="login-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <div class="input-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>
          <input type="email" id="email" placeholder="you@example.com">
        </div>
      </div>

      <button class="btn btn-block" id="sendBtn" type="button">Στείλε μου σύνδεσμο</button>

      {#- Δεύτερη επιλογή, μόνο για όσους έχουν ήδη ενεργοποιήσει passkey —
          ο νέος επισκέπτης ξεκινά πάντα από το email παραπάνω #}
      <div id="passkeyArea" hidden>
        <div class="login-divider">ή</div>
        <button class="btn-passkey" id="passkeyBtn" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg>
          Μπες με Face ID / δαχτυλικό
        </button>
        <p class="passkey-hint">Αν το έχεις ήδη ενεργοποιήσει σε αυτή τη συσκευή</p>
      </div>

      <p class="login-trust">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Το email σου χρησιμοποιείται μόνο για σύνδεση και το newsletter — δεν το μοιραζόμαστε ποτέ. <a href="privacy.html">Πολιτική απορρήτου</a>
      </p>

      <div class="calc-result calc-hidden" id="result"></div>
    </div>

    <ul class="login-perks">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Λαμβάνεις το newsletter με νέα άρθρα και συμβουλές για το τρέξιμο</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg> Φτιάχνεις το προφίλ σου με το όνομά σου και λίγα λόγια για σένα</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.27"/></svg> Μπορείς να διαγραφείς από το newsletter όποτε θέλεις, με ένα κλικ</li>
    </ul>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="js/vendor/simplewebauthn-browser-14.0.0.umd.min.js"></script>
  <script src="js/passkey.js?v={{ site.jsVersion }}"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const API = (location.hostname === 'localhost') ? 'http://localhost:4000' : 'https://api.desekordonia.com';

      function showResult(text, isError) {
        const el = $('result');
        el.textContent = text;
        el.classList.remove('calc-hidden');
        el.style.color = isError ? 'var(--accent-2)' : '';
      }

      async function requestLink() {
        const email = $('email').value.trim();
        if (!email || !email.includes('@')) {
          showResult('Βάλε ένα έγκυρο email.', true);
          return;
        }
        const btn = $('sendBtn');
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Αποστολή…';
        try {
          const r = await fetch(API + '/api/auth/request-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, language: 'el' })
          });
          if (r.ok) {
            showResult('Έλεγξε το email σου για τον σύνδεσμο σύνδεσης (ισχύει 15 λεπτά).', false);
            btn.textContent = '✓ Ο σύνδεσμος στάλθηκε';
            setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 5000);
            return;
          }
          showResult('Κάτι πήγε στραβά. Δοκίμασε ξανά.', true);
        } catch (e) {
          showResult('Δεν μπόρεσα να συνδεθώ με τον server. Τρέχει τοπικά;', true);
        }
        btn.textContent = label;
        btn.disabled = false;
      }

      // Passkey: μόνο αν το υποστηρίζει ο browser· οι επιλογές φορτώνονται από πριν (βλ. js/passkey.js)
      async function passkeyLogin() {
        const btn = $('passkeyBtn');
        btn.disabled = true;
        try {
          await DKPasskey.login();
          location.href = 'account.html';
          return;
        } catch (e) {
          if (DKPasskey.isCancel(e)) {
            showResult('Δεν έχεις ενεργοποιήσει ακόμα Face ID σε αυτή τη συσκευή. Γράψε το email σου παραπάνω — μετά τη σύνδεση θα σου προτείνουμε να το ενεργοποιήσεις.', true);
          } else if (e.status === 400) {
            showResult('Το Face ID αυτής της συσκευής δεν είναι πια συνδεδεμένο με λογαριασμό. Γράψε το email σου παραπάνω και ενεργοποίησέ το ξανά μετά τη σύνδεση.', true);
          } else {
            showResult('Κάτι πήγε στραβά. Δοκίμασε ξανά ή γράψε το email σου παραπάνω.', true);
          }
          DKPasskey.prepareLogin();
        }
        btn.disabled = false;
      }

      if (DKPasskey.supported()) {
        $('passkeyArea').hidden = false;
        DKPasskey.prepareLogin();
        $('passkeyBtn').addEventListener('click', passkeyLogin);
      }

      $('sendBtn').addEventListener('click', requestLink);
      $('email').addEventListener('keydown', (e) => { if (e.key === 'Enter') requestLink(); });
    })();
  </script>
{% endblock %}
