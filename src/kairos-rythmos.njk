        <div class="wp-grid" id="wpGrid"></div>
        <ul class="wp-legend">
          <li><span class="wp-swatch lv-good"></span>Ιδανικά</li>
          <li><span class="wp-swatch lv-fair"></span>Λίγη ζέστη</li>
          <li><span class="wp-swatch lv-hard"></span>Ζέστη</li>
          <li><span class="wp-swatch lv-bad"></span>Πολύ ζέστη</li>
          <li><span class="wp-swatch lv-extreme"></span>Επικίνδυνο</li>
          <li><span class="wp-swatch wp-best"></span>Η πιο δροσερή ώρα</li>
        </ul>

        <div class="wp-result" aria-live="polite">
          <p class="wp-when" id="wpWhen"></p>
          <span class="wp-level" id="wpLevel"></span>
          <div class="pace">
            <div class="big" id="wpPace"></div>
            <span class="label" id="wpPaceLabel"></span>
          </div>
