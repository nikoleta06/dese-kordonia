{% block head_extra2 %}
  <!-- Leaflet (interactive map) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <style>
    #race-map {
      height: 520px;
      width: 100%;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      margin-top: 1.5rem;
      z-index: 1;
    }
    .leaflet-popup-content { font-family: "Inter", sans-serif; }
    .leaflet-popup-content h4 { font-family: "Oswald", sans-serif; margin: 0 0 0.3rem; color: #0f1115; }
    .leaflet-popup-content p { margin: 0 0 0.5rem; color: #333; font-size: 0.9rem; }
    .leaflet-popup-content a { color: #ff5722; font-weight: 600; }
    @media (max-width: 600px) { #race-map { height: 400px; } }

    /* Filters */
    .race-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0 0; }
    .race-filters + .race-filters { margin-top: 0.6rem; }
    .rf-btn { padding: 0.5rem 1rem; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); cursor: pointer; font-family: inherit; font-size: 0.9rem; transition: color .2s, background-color .2s, border-color .2s; }
    .rf-btn:hover { border-color: var(--accent); color: var(--text); }
    .rf-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; }

    /* Legend */
    .map-legend { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 0.8rem; font-size: 0.85rem; color: var(--text-dim); }
    .map-legend span { display: inline-flex; align-items: center; gap: 0.45rem; }
    .leg-dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; border: 2px solid #fff; }

    /* Race cards */
    .race-list { margin-top: 2rem; }
    .race-card .post-body { padding: 1.4rem; }
    .race-card .post-meta { text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.3rem; }
    .race-type { font-weight: 600; }
    .type-road { color: #ff7a50; }
    .type-mountain { color: #3ddc84; }
    .type-ultra { color: #ff6b6b; }
    .race-card h3 { color: var(--text); margin: 0.2rem 0 0.4rem; font-size: 1.2rem; }
    .race-card .race-specs { color: var(--accent-2); font-weight: 600; font-size: 0.88rem; margin-bottom: 0.6rem; }
    .race-card .race-actions { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-top: auto; flex-wrap: wrap; }
    .show-on-map { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.85rem; border-radius: 999px; border: 1px solid var(--border); background: none; color: var(--text-dim); cursor: pointer; font-family: "Oswald", sans-serif; font-size: 0.82rem; transition: color .2s, border-color .2s; }
    .show-on-map:hover { border-color: var(--accent); color: var(--accent); }
    .race-card .read-more { color: var(--accent); font-weight: 600; font-family: "Oswald", sans-serif; font-size: 0.85rem; }
    .race-card p.race-note { font-size: 0.82rem; font-style: italic; color: #ffb347; margin-bottom: 0.6rem; }
  </style>
{% endblock %}

{% block content %}
  <main>
    <h1 class="section-title">Running Races — Greece &amp; Europe</h1>
    <p class="lead">
      From the historic Athens Marathon and mountain races in the Greek highlands to Europe's
      major marathons and half marathons. Filter by region and type, click a marker or press
      "Show on map" on a card to focus on a race. Cards are in chronological order — upcoming
      races first.
    </p>

    <div class="race-filters" role="group" aria-label="Region filter">
      <button class="rf-btn active" data-region="all" type="button">All countries</button>
      <button class="rf-btn" data-region="gr" type="button">Greece</button>
      <button class="rf-btn" data-region="eu" type="button">Europe</button>
    </div>
    <div class="race-filters" role="group" aria-label="Type filter">
      <button class="rf-btn active" data-filter="all" type="button">All</button>
      <button class="rf-btn" data-filter="road" type="button">Road</button>
      <button class="rf-btn" data-filter="mountain" type="button">Mountain</button>
      <button class="rf-btn" data-filter="ultra" type="button">Ultra</button>
    </div>

    <div id="race-map"></div>
    <div class="map-legend">
      <span><i class="leg-dot" style="background:#ff5722"></i>Road</span>
      <span><i class="leg-dot" style="background:#2ecc71"></i>Mountain</span>
      <span><i class="leg-dot" style="background:#e24b4a"></i>Ultra</span>
    </div>

    <div class="race-list post-grid">
      {%- for race in races.list %}
      <article class="post-card race-card" data-type="{{ race.type }}"{% if race.region == "eu" %} data-region="eu"{% endif %} data-month="{{ race.month }}" data-lat="{{ race.lat }}" data-lng="{{ race.lng }}">
        <div class="post-body">
          <p class="post-meta"><span class="race-type type-{{ race.type }}">{{ races.typeLabels[race.type].en }}</span> · {{ races.monthNames.en[race.month - 1] }}{% if race.country %} · {{ race.country.en }}{% endif %}</p>
          <h3>{{ race.name.en }}</h3>
          <p class="race-specs">{{ race.specs.en }}</p>
          <p>{{ race.desc.en }}</p>
          {%- if race.note %}
          <p class="race-note"><svg style="width:1em;height:1em;vertical-align:-0.15em;margin-right:0.3em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>{{ race.note.en }}</p>
          {%- endif %}
          <div class="race-actions">
            <button class="show-on-map" type="button">Show on map</button>
            <a class="read-more" href="{{ race.url.en }}" target="_blank" rel="noopener">Official site →</a>
          </div>
        </div>
      </article>
      {%- endfor %}
    </div>

    <p class="plan-note" style="margin-top:1.5rem;">
      <svg style="width:1em;height:1em;vertical-align:-0.15em;margin-right:0.3em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>Dates and registration change every year — the links take you to the official/up-to-date
      information for each race.
    </p>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    (function () {
      if (typeof L === 'undefined') return;
      var COLORS = { road: '#ff5722', mountain: '#2ecc71', ultra: '#e24b4a' };
      var map = L.map('race-map', { scrollWheelZoom: false }).setView([38.7, 23.5], 6);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap, © CARTO'
      }).addTo(map);

      // Ensure all markers render once layout settles
      map.whenReady(function () { setTimeout(function () { map.invalidateSize(); }, 250); });

      var cards = Array.prototype.slice.call(document.querySelectorAll('.race-card'));
      var entries = [];

      // Chronological order: upcoming races first (rolling from the current month)
      var raceList = document.querySelector('.race-list');
      var thisMonth = new Date().getMonth() + 1;
      cards.sort(function (a, b) {
        return ((a.dataset.month - thisMonth + 12) % 12) - ((b.dataset.month - thisMonth + 12) % 12);
      });
      cards.forEach(function (c) { raceList.appendChild(c); });

      cards.forEach(function (card) {
        var lat = parseFloat(card.dataset.lat), lng = parseFloat(card.dataset.lng);
        if (isNaN(lat) || isNaN(lng)) return;
        var type = card.dataset.type || 'road';
        var name = (card.querySelector('h3') || {}).textContent || '';
        var specs = (card.querySelector('.race-specs') || {}).textContent || '';
        var linkEl = card.querySelector('.read-more');
        var linkHtml = linkEl ? '<a href="' + linkEl.href + '" target="_blank" rel="noopener">' + linkEl.textContent + '</a>' : '';
        var popup = '<h4>' + name + '</h4><p>' + specs + '</p>' + linkHtml;

        var marker = L.circleMarker([lat, lng], {
          radius: 9, color: '#fff', weight: 2,
          fillColor: COLORS[type] || '#ff5722', fillOpacity: 0.95
        }).bindPopup(popup).addTo(map);

        entries.push({ card: card, marker: marker, type: type, region: card.dataset.region || 'gr', lat: lat, lng: lng });

        var btn = card.querySelector('.show-on-map');
        if (btn) btn.addEventListener('click', function () {
          map.flyTo([lat, lng], 11, { duration: 0.8 });
          marker.openPopup();
          document.getElementById('race-map').scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
      });

      // Combined filtering: region (Greece/Europe) + race type
      var regionBtns = Array.prototype.slice.call(document.querySelectorAll('.rf-btn[data-region]'));
      var typeBtns = Array.prototype.slice.call(document.querySelectorAll('.rf-btn[data-filter]'));
      var curRegion = 'all', curType = 'all';

      function applyFilters(fly) {
        var pts = [];
        entries.forEach(function (e) {
          var show = (curRegion === 'all' || e.region === curRegion) &&
                     (curType === 'all' || e.type === curType);
          e.card.style.display = show ? '' : 'none';
          if (show) { e.marker.addTo(map); pts.push([e.lat, e.lng]); }
          else { map.removeLayer(e.marker); }
        });
        if (fly && pts.length) {
          map.flyToBounds(L.latLngBounds(pts).pad(0.15), { duration: 0.8, maxZoom: 7 });
        }
      }

      regionBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          regionBtns.forEach(function (x) { x.classList.remove('active'); });
          b.classList.add('active');
          curRegion = b.dataset.region;
          applyFilters(true);
        });
      });
      typeBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          typeBtns.forEach(function (x) { x.classList.remove('active'); });
          b.classList.add('active');
          curType = b.dataset.filter;
          applyFilters(true);
        });
      });

      // Initial view: fit all races (Greece + Europe) in frame
      if (entries.length) {
        map.fitBounds(L.latLngBounds(entries.map(function (e) { return [e.lat, e.lng]; })).pad(0.1));
      }
    })();
  </script>
{% endblock %}
