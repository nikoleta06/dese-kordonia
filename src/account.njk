---
permalink: "account.html"
lang: "el"
title: "Ο λογαριασμός μου | Δέσε Κορδόνια"
description: "Το προφίλ σου στο Δέσε Κορδόνια."
---

{% extends "base.njk" %}

{% block head_extra0 %}{% endblock %}

{% block head_extra %}
  <meta name="robots" content="noindex">

  <link rel="canonical" href="https://desekordonia.com/account.html">
  <link rel="alternate" hreflang="el" href="https://desekordonia.com/account.html">
  <link rel="alternate" hreflang="en" href="https://desekordonia.com/account-en.html">
  <link rel="alternate" hreflang="x-default" href="https://desekordonia.com/account.html">
{% endblock %}

{% block head_extra2 %}{% endblock %}

{% block content %}
  <main>
    <h1 class="section-title">Ο λογαριασμός μου</h1>
    <p class="lead calc-hidden" id="intro">Το προφίλ σου.</p>

    <div class="calc calc-hidden" id="form">
      <div class="field">
        <label>Email</label>
        <input type="text" id="email" disabled>
      </div>
      <div class="field">
        <label for="name">Όνομα</label>
        <input type="text" id="name" placeholder="Το όνομά σου">
      </div>
      <div class="field">
        <label for="bio">Λίγα λόγια για σένα</label>
        <input type="text" id="bio" placeholder="π.χ. Τρέχω από το 2023">
      </div>
      <div class="newsletter-box">
        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg> Newsletter</h4>
        <p>Νέα άρθρα και συμβουλές για το τρέξιμο, κατευθείαν στο email σου.</p>
        <label><input type="checkbox" id="newsletter"> Θέλω να λαμβάνω το newsletter</label>
        <p class="lang-question">Σε ποια γλώσσα;</p>
        <div class="lang-options">
          <label><input type="radio" name="lang" id="langEl" value="el"> Ελληνικά</label>
          <label><input type="radio" name="lang" id="langEn" value="en"> English</label>
        </div>
      </div>

      <div class="newsletter-box" id="passkeyBox" hidden>
        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01"/><path d="M15 9h.01"/></svg> Σύνδεση με Face ID / δαχτυλικό</h4>
        <p>Από τις συσκευές που έχεις ενεργοποιήσει μπαίνεις με ένα πάτημα, χωρίς email.</p>
        <ul class="passkey-list" id="passkeyList"></ul>
        <button class="btn-passkey" id="passkeyAdd" type="button">Ενεργοποίηση σε αυτή τη συσκευή</button>
        <p id="passkeyMsg" hidden></p>
      </div>

      {#- Κωδικός: προαιρετικός, δουλεύει σε κάθε συσκευή (και σε παλιά κινητά χωρίς Face ID) #}
      <div class="newsletter-box" id="passwordBox">
        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg> Σύνδεση με κωδικό</h4>
        <p id="pwState"></p>
        {#- Τρέχων κωδικός: ζητείται μόνο όταν υπάρχει κωδικός και ο χρήστης μπήκε με κωδικό #}
        <div class="field" id="pwCurrentField" hidden>
          <label for="currentPassword">Τρέχων κωδικός</label>
          <div class="input-wrap pw-wrap">
            <input type="password" id="currentPassword" autocomplete="current-password" placeholder="Ο κωδικός σου">
            <button class="pw-eye" id="pwEyeCurrent" type="button" aria-pressed="false" aria-label="Εμφάνιση κωδικού" title="Εμφάνιση κωδικού"></button>
          </div>
        </div>
        <div class="field">
          <label for="newPassword">Νέος κωδικός</label>
          <div class="input-wrap pw-wrap">
            <input type="password" id="newPassword" autocomplete="new-password" minlength="8" placeholder="8+ χαρακτήρες">
            <button class="pw-eye" id="pwEye" type="button" aria-pressed="false" aria-label="Εμφάνιση κωδικού" title="Εμφάνιση κωδικού"></button>
          </div>
        </div>
        <button class="btn-passkey" id="pwSave" type="button"></button>
        <p id="pwMsg" hidden></p>
        <div class="pw-remove-row">
          <button class="btn-danger-link" id="pwRemove" type="button" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg> Αφαίρεση κωδικού</button>
        </div>
      </div>

      {#- Κύρια ενέργεια + αποσύνδεση (ίδιο ύψος· στο κινητό η μία κάτω από την άλλη) #}
      <div class="account-actions">
        <button class="btn" id="saveBtn" type="button">Αποθήκευση</button>
        <button class="btn-ghost" id="logoutBtn" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg> Αποσύνδεση</button>
      </div>

      <div class="calc-result calc-hidden" id="result"></div>

      {#- Η διαγραφή χωριστά και διακριτικά, για να μην πατιέται κατά λάθος #}
      <div class="account-danger">
        <button class="btn-danger-link" id="deleteBtn" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg> Διαγραφή λογαριασμού</button>
      </div>
    </div>

    <p id="status">Έλεγχος σύνδεσης...</p>
  </main>
{% endblock %}

{% block body_extra %}{% endblock %}

{% block scripts_extra %}
  <script src="js/vendor/simplewebauthn-browser-14.0.0.umd.min.js"></script>
  <script src="js/passkey.js?v={{ site.jsVersion }}"></script>
  <script src="js/password.js?v={{ site.jsVersion }}"></script>
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const API = (location.hostname === 'localhost') ? 'http://localhost:4000' : 'https://api.desekordonia.com';

      function fill(user) {
        $('email').value = user.email;
        $('name').value = user.name || '';
        $('bio').value = user.bio || '';
        $('newsletter').checked = !!user.newsletter_subscribed;
        $(user.language === 'en' ? 'langEn' : 'langEl').checked = true;
        $('status').classList.add('calc-hidden');
        $('intro').classList.remove('calc-hidden');
        $('form').classList.remove('calc-hidden');
      }

      async function load() {
        try {
          const r = await fetch(API + '/api/auth/me', { credentials: 'include' });
          if (!r.ok) {
            location.href = 'login.html';
            return;
          }
          const user = await r.json();
          fill(user);
          initPasskeys();
          renderPassword(!!user.has_password, user.signed_in_with);
        } catch (e) {
          $('status').textContent = "Δεν μπόρεσα να συνδεθώ με τον server. Τρέχει τοπικά;";
        }
      }

      async function save() {
        $('saveBtn').disabled = true;
        try {
          const r = await fetch(API + '/api/profile', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              name: $('name').value.trim(),
              bio: $('bio').value.trim(),
              newsletter_subscribed: $('newsletter').checked,
              language: $('langEn').checked ? 'en' : 'el'
            })
          });
          const result = $('result');
          result.classList.remove('calc-hidden');
          result.textContent = r.ok ? 'Αποθηκεύτηκε!' : 'Κάτι πήγε στραβά.';
        } catch (e) {
          const result = $('result');
          result.classList.remove('calc-hidden');
          result.textContent = "Δεν μπόρεσα να συνδεθώ με τον server.";
        }
        $('saveBtn').disabled = false;
      }

      async function logout() {
        try {
          await fetch(API + '/api/auth/logout', { method: 'POST', credentials: 'include' });
        } catch (e) {}
        location.href = 'index.html';
      }

      async function deleteAccount() {
        if (!confirm('Σίγουρα θέλεις να διαγράψεις τον λογαριασμό σου; Θα σβηστούν όλα τα στοιχεία σου και η ενέργεια δεν αναιρείται.')) return;
        $('deleteBtn').disabled = true;
        try {
          await fetch(API + '/api/profile', { method: 'DELETE', credentials: 'include' });
        } catch (e) {}
        location.href = 'index.html';
      }

      /* --- Passkeys (Face ID / δαχτυλικό) --- */
      function passkeyMsg(text) {
        $('passkeyMsg').textContent = text;
        $('passkeyMsg').hidden = !text;
      }

      function fmtDate(iso) {
        return iso ? new Date(iso).toLocaleDateString('el-GR') : '';
      }

      async function renderPasskeys() {
        const list = $('passkeyList');
        let keys = [];
        try { keys = await DKPasskey.list(); } catch (e) {}
        list.innerHTML = '';
        keys.forEach((k) => {
          const li = document.createElement('li');
          const info = document.createElement('div');
          info.textContent = k.device_label || 'Συσκευή';
          const meta = document.createElement('small');
          meta.textContent = 'Προστέθηκε ' + fmtDate(k.created_at) +
            (k.last_used_at ? ' · τελευταία σύνδεση ' + fmtDate(k.last_used_at) : '');
          info.appendChild(meta);
          const del = document.createElement('button');
          del.type = 'button';
          del.textContent = 'Αφαίρεση';
          del.addEventListener('click', async () => {
            if (!confirm('Να αφαιρεθεί η σύνδεση με Face ID από αυτή τη συσκευή; Θα μπορείς πάντα να μπαίνεις με email.')) return;
            try { await DKPasskey.remove(k.id); } catch (e) {}
            renderPasskeys();
          });
          li.appendChild(info);
          li.appendChild(del);
          list.appendChild(li);
        });
      }

      function initPasskeys() {
        if (!DKPasskey.supported()) return;
        $('passkeyBox').hidden = false;
        renderPasskeys();
        DKPasskey.prepareRegister();
      }

      $('passkeyAdd').addEventListener('click', async () => {
        const btn = $('passkeyAdd');
        btn.disabled = true;
        passkeyMsg('');
        try {
          await DKPasskey.register();
          passkeyMsg('Έτοιμο! Την επόμενη φορά πάτα «Μπες με Face ID / δαχτυλικό» στη σελίδα σύνδεσης.');
          renderPasskeys();
        } catch (e) {
          if (DKPasskey.isAlreadyRegistered(e)) passkeyMsg('Το Face ID είναι ήδη ενεργό σε αυτή τη συσκευή.');
          else if (DKPasskey.isCancel(e)) passkeyMsg('Η ενεργοποίηση ακυρώθηκε.');
          else passkeyMsg('Δεν έγινε η ενεργοποίηση. Δοκίμασε ξανά.');
        }
        DKPasskey.prepareRegister();
        btn.disabled = false;
      });

      /* --- Κωδικός --- */
      let hasPassword = false;
      let needCurrent = false; // υπάρχει κωδικός και ο χρήστης μπήκε με κωδικό

      function pwMsg(text) {
        $('pwMsg').textContent = text;
        $('pwMsg').hidden = !text;
      }

      function renderPassword(has, signedInWith) {
        hasPassword = has;
        needCurrent = has && signedInWith === 'password';
        $('pwState').textContent = has ? 'Έχεις ορίσει κωδικό: μπαίνεις με το email και τον κωδικό σου, χωρίς να περιμένεις σύνδεσμο.' : 'Δεν έχεις ορίσει κωδικό. Όρισε έναν για να μπαίνεις με email και κωδικό, χωρίς να περιμένεις σύνδεσμο — δουλεύει σε κάθε κινητό.';
        $('pwSave').textContent = has ? 'Αλλαγή κωδικού' : 'Ορισμός κωδικού';
        $('pwRemove').hidden = !has;
        $('pwCurrentField').hidden = !needCurrent;
        $('currentPassword').value = '';
      }

      DKPassword.wireToggle($('newPassword'), $('pwEye'), { show: 'Εμφάνιση κωδικού', hide: 'Απόκρυψη κωδικού' });
      DKPassword.wireToggle($('currentPassword'), $('pwEyeCurrent'), { show: 'Εμφάνιση κωδικού', hide: 'Απόκρυψη κωδικού' });

      // Κοινός χειρισμός λαθών για αλλαγή / αφαίρεση
      function pwError(e) {
        if (DKPassword.isWrongCurrent(e)) {
          pwMsg('Ο τρέχων κωδικός δεν είναι σωστός.');
          $('currentPassword').focus();
        } else if (e.status === 400) {
          pwMsg('Ο κωδικός πρέπει να έχει τουλάχιστον 8 χαρακτήρες.');
        } else if (e.status === 401) {
          pwMsg('Η σύνδεσή σου έληξε ή έγινε αλλαγή κωδικού από άλλη συσκευή. Συνδέσου ξανά.');
        } else {
          pwMsg('Δεν αποθηκεύτηκε ο κωδικός. Δοκίμασε ξανά.');
        }
      }

      function currentOrAsk() {
        const current = $('currentPassword').value;
        if (needCurrent && !current) {
          pwMsg('Γράψε πρώτα τον τρέχοντα κωδικό σου.');
          $('currentPassword').focus();
          return null;
        }
        return current;
      }

      async function savePassword() {
        const btn = $('pwSave');
        const password = $('newPassword').value;
        pwMsg('');
        const current = currentOrAsk();
        if (current === null) return;
        if (password.length < DKPassword.MIN_LENGTH) {
          pwMsg('Ο κωδικός πρέπει να έχει τουλάχιστον 8 χαρακτήρες.');
          $('newPassword').focus();
          return;
        }
        btn.disabled = true;
        try {
          const r = await DKPassword.set(password, current);
          const changed = hasPassword;
          $('newPassword').value = '';
          // Μετά την αλλαγή ο χρήστης έχει πάλι session «με κωδικό» μόνο αν είχε ήδη
          renderPassword(true, needCurrent ? 'password' : null);
          pwMsg(changed && r.otherDevicesSignedOut ? 'Ο κωδικός άλλαξε. Όσες άλλες συσκευές ήταν συνδεδεμένες αποσυνδέθηκαν — εδώ παραμένεις συνδεδεμένος/η.' : 'Έτοιμο! Την επόμενη φορά πάτα «Μπες με κωδικό» στη σελίδα σύνδεσης.');
        } catch (e) {
          pwError(e);
        }
        btn.disabled = false;
      }
      $('pwSave').addEventListener('click', savePassword);
      $('newPassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') savePassword(); });
      $('currentPassword').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('newPassword').focus(); });

      $('pwRemove').addEventListener('click', async () => {
        pwMsg('');
        const current = currentOrAsk();
        if (current === null) return;
        if (!confirm('Να αφαιρεθεί ο κωδικός; Θα μπαίνεις με σύνδεσμο στο email (ή με Face ID, αν το έχεις ενεργοποιήσει), και όσες άλλες συσκευές είναι συνδεδεμένες θα αποσυνδεθούν.')) return;
        try {
          await DKPassword.remove(current);
          renderPassword(false, null);
          pwMsg('Ο κωδικός αφαιρέθηκε και οι άλλες συσκευές αποσυνδέθηκαν.');
        } catch (e) {
          pwError(e);
        }
      });

      $('saveBtn').addEventListener('click', save);
      $('logoutBtn').addEventListener('click', logout);
      $('deleteBtn').addEventListener('click', deleteAccount);
      load();
    })();
  </script>
{% endblock %}
