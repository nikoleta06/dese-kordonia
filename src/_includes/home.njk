{#- Το περιεχόμενο της αρχικής (index.njk / index-en.njk), κοινό για τις δύο γλώσσες.
    Πάνω ένα μικρότερο hero και μετά πλέγμα «bento»: κάρτα καιρού (js/home.js),
    το πιο πρόσφατο άρθρο, οι επόμενοι αγώνες, τα εργαλεία. Από κάτω πρόσφατα άρθρα με
    κατηγορίες, ποια είμαι και newsletter. -#}
{%- set en = lang == "en" %}
{%- set sfx = "-en" if en else "" %}
{%- set latest = postsData.posts[0] %}
{%- set latestCat = postsData.cats[latest.cat] %}
  <section class="hero hero-compact">
    <div class="hero-content">
      <h1>Δέσε <span class="accent">Κορδόνια</span></h1>
      <p>{% if en %}Because every kilometre hides a story.{% else %}Γιατί κάθε χιλιόμετρο κρύβει μια ιστορία.{% endif %}</p>
      <div class="hero-buttons">
        <a class="btn" href="programma-5k{{ sfx }}.html">{% if en %}Start the journey{% else %}Ξεκίνα το ταξίδι{% endif %}</a>
        <a class="btn-outline" href="blog{{ sfx }}.html">{% if en %}Read the articles{% else %}Διάβασε τα άρθρα{% endif %}</a>
      </div>
      <button class="why-link" id="whyOpen" type="button">{% if en %}Why do you run?{% else %}Γιατί τρέχεις;{% endif %}</button>
    </div>
  </section>

  <main class="home">
    <div class="bento">

      {#- Καιρός: χωρίς JavaScript μένει κάρτα που οδηγεί στο εργαλείο· το js/home.js τη γεμίζει
          με την πρόγνωση για την πόλη που έχει διαλέξει ο επισκέπτης (ή την Αθήνα). #}
      <a class="bento-card b-weather" href="kairos-rythmos{{ sfx }}.html" id="homeWeather">
        <p class="b-kicker">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          {% if en %}Running weather today{% else %}Ο καιρός για τρέξιμο σήμερα{% endif %}
        </p>
        <h2 class="b-title" id="hwTitle">{% if en %}How much should you slow down today?{% else %}Πόσο να κόψεις τον ρυθμό σήμερα;{% endif %}</h2>
        <p class="b-text" id="hwText">{% if en %}Enter your pace and your city, and see how heat and humidity change it, and the coolest hour to run.{% else %}Βάλε τον ρυθμό σου και την πόλη σου, και δες πόσο τον αλλάζουν η ζέστη και η υγρασία, και ποια είναι η πιο δροσερή ώρα για τρέξιμο.{% endif %}</p>
        <div class="hw-stats" id="hwStats" hidden>
          <span class="wp-level" id="hwLevel"></span>
          <dl>
            <div><dt>{% if en %}Your pace{% else %}Ο ρυθμός σου{% endif %}</dt><dd id="hwPace"></dd></div>
            <div><dt id="hwBestLabel">{% if en %}Coolest hour{% else %}Πιο δροσερή ώρα{% endif %}</dt><dd id="hwBest"></dd></div>
          </dl>
        </div>
        <span class="b-more">{% if en %}Open the tool{% else %}Άνοιξε το εργαλείο{% endif %} →</span>
      </a>

      {#- Το πιο πρόσφατο άρθρο, με ετικέτα «Νέο» για 30 μέρες #}
      <a class="bento-card b-latest" href="{{ latest.slug }}{{ sfx }}.html">
        <picture>
          <source type="image/avif" srcset="images/{{ latestCat.img }}.avif?v=1">
          <source type="image/webp" srcset="images/{{ latestCat.img }}.webp?v=1">
          <img src="images/{{ latestCat.img }}.jpg?v=1" alt="" loading="lazy" decoding="async">
        </picture>
        <div class="b-latest-body">
          <p class="b-kicker"><span class="new-badge" data-published="{{ latest.date }}" hidden>{% if en %}New{% else %}Νέο{% endif %}</span>{{ latestCat.label[lang] }}</p>
          <h2 class="b-title">{{ latest[lang] }}</h2>
          <p class="b-text">{{ latest.feed[lang].desc }}</p>
          <span class="b-more">{% if en %}Read the article{% else %}Διάβασε το άρθρο{% endif %} →</span>
        </div>
      </a>

      {#- Οι επόμενοι αγώνες στην Ελλάδα· φαίνονται οι 3 πρώτοι (CSS). Το js/home.js τους
          ξαναταξινομεί με τη σημερινή μέρα και, όπου υπάρχει ημερομηνία, βάζει τη μέρα και
          αντίστροφη μέτρηση στη θέση του μήνα #}
      <div class="bento-card b-races">
        <p class="b-kicker">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
          {% if en %}Upcoming races in Greece{% else %}Επόμενοι αγώνες στην Ελλάδα{% endif %}
        </p>
        <ol class="b-race-list" id="homeRaces">
          {%- for r in races.list | racesFromNow("gr") %}
          <li data-month="{{ r.month }}"{% if r.date %} data-date="{{ r.date }}"{% endif %}{% if r.dateEnd %} data-date-end="{{ r.dateEnd }}"{% endif %}>
            <span class="b-race-month">{{ races.monthNames[lang][r.month - 1] }}</span>
            <span class="b-race-name">{{ r.name[lang] }}</span>
            <span class="b-race-specs">{{ r.specs[lang] }}</span>
          </li>
          {%- endfor %}
        </ol>
        <a class="b-more" href="agones{{ sfx }}.html">{% if en %}All races on the map{% else %}Όλοι οι αγώνες στον χάρτη{% endif %} →</a>
      </div>

      {#- Τα εργαλεία #}
      <a class="bento-card b-tool" href="calculator{{ sfx }}.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <h3>{% if en %}Pace calculator{% else %}Υπολογιστής ρυθμού{% endif %}</h3>
        <p>{% if en %}Your pace per km, or your goal time{% else %}Ρυθμός ανά χλμ. ή χρόνος-στόχος{% endif %}</p>
      </a>
      <a class="bento-card b-tool" href="zones-palmon{{ sfx }}.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        <h3>{% if en %}Heart-rate zones{% else %}Ζώνες παλμών{% endif %}</h3>
        <p>{% if en %}Your five training zones{% else %}Οι πέντε ζώνες προπόνησής σου{% endif %}</p>
      </a>
      <a class="bento-card b-tool" href="provlepsi-agona{{ sfx }}.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/></svg>
        <h3>{% if en %}Race predictor{% else %}Πρόβλεψη αγώνα{% endif %}</h3>
        <p>{% if en %}5K to marathon, from one result{% else %}Από 5Κ έως μαραθώνιο{% endif %}</p>
      </a>
      <a class="bento-card b-tool" href="programma-5k{{ sfx }}.html">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 5.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="m9 22 2-6 3 3v5"/><path d="m6 12 3-4 4 1 3 3 3 1"/><path d="m9 8-2 7"/></svg>
        <h3>{% if en %}5K plan{% else %}Πρόγραμμα 5K{% endif %}</h3>
        <p>{% if en %}From zero to 5 km in 8 weeks{% else %}Από το μηδέν στα 5 χλμ. σε 8 εβδομάδες{% endif %}</p>
      </a>
    </div>

    {#- Πρόσφατα άρθρα και κατηγορίες: για να συνεχίσει κάποιος να διαβάζει #}
    <section class="home-section">
      <div class="home-section-head">
        <h2 class="section-title">{% if en %}More to read{% else %}Διάβασε ακόμα{% endif %}</h2>
        <a class="b-more" href="blog{{ sfx }}.html">{% if en %}All articles{% else %}Όλα τα άρθρα{% endif %} →</a>
      </div>
      <div class="home-cats">
        {%- for key, c in postsData.cats %}
        <a class="home-cat" href="blog{{ sfx }}.html?cat={{ key }}">{{ c.svg | safe }}{{ c[lang] }}<span>{{ postsData.posts | countCat(key) }}</span></a>
        {%- endfor %}
      </div>
      <div class="home-posts">
        {%- for p in postsData.posts.slice(1, 4) %}
        {%- set pc = postsData.cats[p.cat] %}
        <a class="home-post" href="{{ p.slug }}{{ sfx }}.html">
          <picture>
            <source type="image/avif" srcset="images/{{ pc.img }}.avif?v=1">
            <source type="image/webp" srcset="images/{{ pc.img }}.webp?v=1">
            <img src="images/{{ pc.img }}.jpg?v=1" alt="" loading="lazy" decoding="async">
          </picture>
          <p class="b-kicker">{{ pc[lang] }}</p>
          <h3>{{ p[lang] }}</h3>
        </a>
        {%- endfor %}
      </div>
    </section>

    {#- Ποια είμαι + newsletter #}
    <section class="home-duo">
      <div class="bento-card home-about">
        <picture>
          <source type="image/avif" srcset="images/cat-desekordonia.avif?v=1">
          <source type="image/webp" srcset="images/cat-desekordonia.webp?v=1">
          <img src="images/cat-desekordonia.jpg?v=1" alt="" loading="lazy" decoding="async">
        </picture>
        <div>
          <h2 class="b-title">{% if en %}How I started running{% else %}Πώς ξεκίνησα το τρέξιμο{% endif %}</h2>
          <p class="b-text">{% if en %}I first ran two months after my university entrance exams, to keep my brother company on his training run. Today I run 15 km non-stop and I'm training for the marathon.{% else %}Έτρεξα πρώτη φορά δύο μήνες μετά τις πανελλαδικές, για να κάνω παρέα στον αδερφό μου στην προπόνησή του. Σήμερα τρέχω 15 χλμ. ασταμάτητα και προπονούμαι για τον μαραθώνιο.{% endif %}</p>
          <a class="b-more" href="about{{ sfx }}.html">{% if en %}Read the whole story{% else %}Διάβασε όλη την ιστορία{% endif %} →</a>
        </div>
      </div>
      <div class="bento-card home-newsletter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <h2 class="b-title">{% if en %}New articles in your inbox{% else %}Τα νέα άρθρα στο email σου{% endif %}</h2>
        <p class="b-text">{% if en %}Articles and running tips, a few times a month. Unsubscribe with one click.{% else %}Άρθρα και συμβουλές για το τρέξιμο, λίγες φορές τον μήνα. Απεγγραφή με ένα κλικ.{% endif %}</p>
        <a class="btn" href="login{{ sfx }}.html">{% if en %}Subscribe to the newsletter{% else %}Γράψου στο newsletter{% endif %}</a>
      </div>
    </section>

    <div class="quote">
      <blockquote>
        {% if en %}"I don't run to escape life. I run to <span class="accent">feel</span> it more intensely."{% else %}«Δεν τρέχω για να ξεφύγω από τη ζωή. Τρέχω για να την <span class="accent">νιώσω</span> πιο έντονα.»{% endif %}
      </blockquote>
      <cite>Δέσε Κορδόνια</cite>
    </div>
  </main>
  <script>
    document.querySelectorAll('.new-badge[data-published]').forEach(function (b) {
      if (Date.now() - Date.parse(b.dataset.published) < 30 * 864e5) b.hidden = false;
    });
  </script>
