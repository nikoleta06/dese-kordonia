{#- Το πιο πρόσφατο άρθρο στην αρχική (index.njk / index-en.njk). Παίρνει μόνο του το
    νεότερο από το postsData.posts, οπότε κάθε νέο άρθρο εμφανίζεται εδώ στο επόμενο build.
    Η ετικέτα «Νέο» φαίνεται για 30 μέρες από τη δημοσίευση (ελέγχεται στον browser,
    ώστε να φεύγει μόνη της χωρίς να χρειάζεται νέο build). -#}
{%- set p = postsData.posts[0] %}
{%- set c = postsData.cats[p.cat] %}
{%- set en = lang == "en" %}
    <h2 class="section-title featured-heading"><svg style="width:0.9em;height:0.9em;vertical-align:-0.05em;margin-right:0.3em;color:var(--accent-2)" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.26 6.88.56-5.2 4.52 1.56 6.7L12 17.27 5.86 20.54l1.56-6.7-5.2-4.52 6.88-.56z"/></svg>{% if en %}Latest article{% else %}Το πιο πρόσφατο άρθρο{% endif %}</h2>
    <article class="featured">
      <picture>
        <source type="image/avif" srcset="images/{{ c.img }}.avif?v=1">
        <source type="image/webp" srcset="images/{{ c.img }}.webp?v=1">
        <img src="images/{{ c.img }}.jpg?v=1" alt="{{ p[lang] | escape }}" loading="lazy" decoding="async">
      </picture>
      <div class="featured-body">
        <p class="featured-tag"><span class="new-badge" data-published="{{ p.date }}" hidden>{% if en %}New{% else %}Νέο{% endif %}</span>{{ c.label[lang] }}</p>
        <h3>{{ p[lang] }}</h3>
        <p>{{ p.feed[lang].desc }}</p>
        <a class="btn" href="{{ p.slug }}{% if en %}-en{% endif %}.html">{% if en %}Read the article{% else %}Διάβασε το άρθρο{% endif %}</a>
      </div>
    </article>
    <script>
      document.querySelectorAll('.new-badge[data-published]').forEach(function (b) {
        if (Date.now() - Date.parse(b.dataset.published) < 30 * 864e5) b.hidden = false;
      });
    </script>
